ORCH_DEFAULT_RECIPIENTS=you@example.com
ORCH_AUTH_TOKEN=
# Optional scoped API keys. Format:
# name:token:scope+scope;name2:token2:scope
# Scopes: read, write, metrics, admin. ORCH_AUTH_TOKEN is treated as admin.
ORCH_API_KEYS=

# Example for Gmail SMTP. Use a Google app password, not your normal password.
ORCH_SMTP_HOST=smtp.gmail.com
ORCH_SMTP_PORT=587
ORCH_SMTP_USERNAME=you@example.com
ORCH_SMTP_PASSWORD=
ORCH_SMTP_FROM=you@example.com

# Optional: enables natural-language job/workflow creation.
OPENAI_API_KEY=
ORCH_OPENAI_MODEL=gpt-5.4-nano

# Public account-based website (compose.hosted.yaml); never expose these to Vite.
# Set a domain you own and point its DNS at the hosting server.
ORCH_DOMAIN=
ORCH_PUBLIC_URL=http://localhost:8080
ORCH_GOOGLE_CLIENT_ID=
ORCH_GOOGLE_CLIENT_SECRET=
# Account verification and password recovery; requires authenticated STARTTLS.
# Separate from job-notification SMTP. Blank host disables email signup/recovery.
ORCH_AUTH_SMTP_HOST=
ORCH_AUTH_SMTP_PORT=587
ORCH_AUTH_SMTP_USERNAME=
ORCH_AUTH_SMTP_PASSWORD=
ORCH_AUTH_SMTP_FROM=
# Use a URL-safe random password, such as the output of openssl rand -hex 32.
ORCH_HOSTED_DB_PASSWORD=
ORCH_USER_DATA_DIR=/var/lib/orchestrator/users
ORCH_MAX_USERS=5
# Leave blank to use the connected account's Codex default model.
ORCH_CODEX_MODEL=
